  {
   "cell_type": "markdown",
   "id": "c91e569b-f2c7-472c-a4d1-b0c6284baa45",
   "metadata": {},
   "source": [
    "## 5.2: Manhattan distance + DBSCAN"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "d83e15ab-70b8-471f-91eb-85c6c1f6ba46",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Data used for clustering: (1233, 10)\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x600 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "\n",
    "print(\"Data used for clustering:\", X_cluster.shape)\n",
    "\n",
    "# 1. Manhattan distance function\n",
    "def manhattan_distance(point1, point2):\n",
    "    assert len(point1) == len(point2)\n",
    "    distance = 0\n",
    "    for x1, x2 in zip(point1, point2):\n",
    "        distance += abs(x1 - x2)\n",
    "    return distance\n",
    "\n",
    "# 2. DBSCAN clustering using ALL 10 PCs\n",
    "dbscan = DBSCAN(\n",
    "    eps=4,\n",
    "    min_samples=12,\n",
